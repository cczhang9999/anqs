server:
  http_port: ":30044"
  debug: false

logger:
  # 日志存放路径，当前目录的log文件夹
  path: "./logs"
  # 日志打印等级，[debug, info, warn, err, off]
  level: "debug"
  # 最大存放时间，7天，超过7天的日志会删除
  max_age: 7
  # 日志分割时间，24小时，日志以1天为单位分割，一天一个文件
  rotation_time: 24
  # 是否打印日志
  debug: true
  # 是否存储日志
  writefile: true

legal_tender_db:
  # 调试模式开关
  debug: true
  # mysql连接
  # connection: root:f5Vcnk8H3NgWC045NPbS@tcp(172.30.82.50:3306)/tracing_sas_view?charset=utf8&parseTime=True&loc=Local
  connection: "root:1qaz@WSX@tcp(127.0.0.1:3306)/xops_aegis_guard?charset=utf8mb4&parseTime=True&loc=Local"
  # 连接池中每个连接的最大生存时间，单位秒。
  connmaxlifetime: 0
  # 连接池中允许同时打开的最大连接数
  maxopenconns: 100
  # 连接池中允许存在的最大空闲连接数
  maxidleconns: 10
  colorful: true

